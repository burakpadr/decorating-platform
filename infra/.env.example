# Copy to .env on the server and restrict the permissions:
#   cp .env.example .env && chmod 600 .env
#
# Do not introduce a secrets manager for a single VPS — the file plus tight permissions is the
# right trade at this scale. Never commit .env.

# Registrable domain. web serves ${DOMAIN}, api serves api.${DOMAIN}, MinIO serves
# storage.${DOMAIN}. They share a registrable domain on purpose: it is what lets the anonymous
# session cookie work with `Domain=.${DOMAIN}; SameSite=Lax`.
DOMAIN=example.com

# Container registry and image tag, set by CI on deploy.
REGISTRY=ghcr.io/your-org
TAG=latest

POSTGRES_DB=decorating
POSTGRES_USER=decorating
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=decorating
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=decorating-photos

# --- Not yet wired, listed so nothing is forgotten (spec §16) ---

# SMS provider. Sender ID registration takes time — start it early.
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=

# Vision provider. A data processing agreement is required before real photos go through it.
# VISION_API_KEY=
# VISION_MODEL=

# Operator login for the /api/op/** realm.
# OPERATOR_USERNAME=
# OPERATOR_PASSWORD_HASH=
