{
  "name": "@decorating/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client generated from the API's OpenAPI spec. Both openapi.json and the generated types are committed; CI regenerates and fails on a diff.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.d.ts"
    }
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "build": "pnpm run generate",
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
