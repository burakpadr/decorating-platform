{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Decorating Platform API",
    "description" : "Quoting and customer modules.",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin"
  } ],
  "paths" : {
    "/api/op/price-books/{id}/items/{code}" : {
      "put" : {
        "tags" : [ "price-book-controller" ],
        "operationId" : "updateItem",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "code",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "WALL_PAINT", "CEILING_PAINT", "PATCH_FILLING", "SKIM_COAT", "PRIMER", "STAIN_BLOCK_PRIMER", "WALLPAPER_STRIPPING", "DOOR_PAINT", "TRIM_PAINT", "RADIATOR_PAINT", "DOWNLIGHT_CUTTING", "CORNICE_CUTTING", "MASKING", "MOBILIZATION" ]
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateItemRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The item as it now stands",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PriceBookItemResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "A figure the price list cannot hold",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "No version with that id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "The version has priced quotes; copy it and edit the copy",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/quote-requests" : {
      "post" : {
        "tags" : [ "quote-request-controller" ],
        "summary" : "Start a draft and take ownership of it",
        "operationId" : "create",
        "responses" : {
          "201" : {
            "description" : "Created. Carries the session cookie every later call needs.",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuoteRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/quote-requests/{id}/estimate" : {
      "post" : {
        "tags" : [ "quote-request-controller" ],
        "summary" : "The instant range for the answers given so far",
        "operationId" : "estimate",
        "parameters" : [ {
          "name" : "owned",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/OwnedQuoteRequest"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The range, the areas it assumed, and how wide the band is",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StageOneEstimateResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No session cookie",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StageOneEstimateResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "The session owns a different draft",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StageOneEstimateResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Not all of §2.1's questions are answered yet",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StageOneEstimateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/op/price-calculations" : {
      "post" : {
        "tags" : [ "quote-calculation-controller" ],
        "operationId" : "calculate",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CalculateQuoteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The price and everything assumed to reach it",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuoteCalculationResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "A job the price book cannot price",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/op/price-books" : {
      "get" : {
        "tags" : [ "price-book-controller" ],
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PriceBookSummaryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "price-book-controller" ],
        "operationId" : "create_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreatePriceBookVersionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "The new version, inactive",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PriceBookSummaryResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No source version with that id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "That version code is taken",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/op/price-books/{id}/bulk-increase" : {
      "post" : {
        "tags" : [ "price-book-controller" ],
        "operationId" : "bulkIncrease",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BulkIncreaseRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "The raised version, inactive",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PriceBookSummaryResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "A percent nobody meant to type",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "No version with that id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/op/price-books/{id}/activate" : {
      "post" : {
        "tags" : [ "price-book-controller" ],
        "operationId" : "activate",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The version, now live",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PriceBookSummaryResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No version with that id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/quote-requests/{id}" : {
      "patch" : {
        "tags" : [ "quote-request-controller" ],
        "summary" : "Answer more of the eight questions",
        "operationId" : "answer",
        "parameters" : [ {
          "name" : "owned",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/OwnedQuoteRequest"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PatchQuoteRequestRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The draft as stored, after the merge",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuoteRequestResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No session cookie",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuoteRequestResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "The session owns a different draft",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuoteRequestResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "No longer a draft: the answers are fixed once the room list is confirmed",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QuoteRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/op/price-books/{id}" : {
      "get" : {
        "tags" : [ "price-book-controller" ],
        "operationId" : "detail",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The version, its items and its coefficients",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PriceBookDetailResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No version with that id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "UpdateItemRequest" : {
        "type" : "object",
        "properties" : {
          "materialCost" : {
            "type" : "number",
            "minimum" : 0.00
          },
          "labourMinutes" : {
            "type" : "number",
            "minimum" : 0.00
          }
        },
        "required" : [ "labourMinutes", "materialCost" ]
      },
      "PriceBookItemResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "WALL_PAINT", "CEILING_PAINT", "PATCH_FILLING", "SKIM_COAT", "PRIMER", "STAIN_BLOCK_PRIMER", "WALLPAPER_STRIPPING", "DOOR_PAINT", "TRIM_PAINT", "RADIATOR_PAINT", "DOWNLIGHT_CUTTING", "CORNICE_CUTTING", "MASKING", "MOBILIZATION" ]
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "SQM", "UNIT", "ROOM", "LUMP_SUM" ]
          },
          "labourCost" : {
            "type" : "number"
          },
          "materialCost" : {
            "type" : "number"
          },
          "labourMinutes" : {
            "type" : "number"
          }
        },
        "required" : [ "code", "labourCost", "labourMinutes", "materialCost", "unit" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "QuoteRequestResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PHOTOS_PENDING", "ANALYZING", "RECAPTURE_REQUIRED", "PENDING_REVIEW", "SURVEY_REQUIRED", "QUOTE_SENT", "AWAITING_CONTACT", "CLOSED" ]
          },
          "priceable" : {
            "type" : "boolean"
          },
          "districtCode" : {
            "type" : "string"
          },
          "area" : {
            "type" : "number"
          },
          "areaBasis" : {
            "type" : "string",
            "enum" : [ "GROSS", "NET" ]
          },
          "layout" : {
            "type" : "string",
            "enum" : [ "STUDIO", "ONE_PLUS_ONE", "TWO_PLUS_ONE", "THREE_PLUS_ONE", "FOUR_PLUS_ONE", "FIVE_PLUS_ONE" ]
          },
          "scope" : {
            "type" : "string",
            "enum" : [ "WHOLE_HOME", "SELECTED_ROOMS" ]
          },
          "furnishing" : {
            "type" : "string",
            "enum" : [ "EMPTY", "PARTIAL", "FURNISHED" ]
          },
          "doorCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "doorColourChange" : {
            "type" : "boolean"
          },
          "wallCondition" : {
            "type" : "string",
            "enum" : [ "GOOD", "MINOR", "MAJOR", "UNSURE" ]
          },
          "selectedRooms" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "LIVING_ROOM", "MASTER_BEDROOM", "BEDROOM", "STUDY", "KITCHEN", "BATHROOM", "HALLWAY", "BALCONY" ]
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "id", "priceable", "status" ]
      },
      "OwnedQuoteRequest" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "CalculatedRoomResponse" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "enum" : [ "LIVING_ROOM", "MASTER_BEDROOM", "BEDROOM", "STUDY", "KITCHEN", "BATHROOM", "HALLWAY", "BALCONY" ]
          },
          "label" : {
            "type" : "string"
          },
          "requiredPhotos" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "label", "requiredPhotos", "type" ]
      },
      "StageOneEstimateResponse" : {
        "type" : "object",
        "properties" : {
          "low" : {
            "type" : "number"
          },
          "high" : {
            "type" : "number"
          },
          "bandRatio" : {
            "type" : "number"
          },
          "netArea" : {
            "type" : "number"
          },
          "areaWasGross" : {
            "type" : "boolean"
          },
          "rooms" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CalculatedRoomResponse"
            }
          },
          "photoCount" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "areaWasGross", "bandRatio", "high", "low", "netArea", "photoCount", "rooms" ]
      },
      "CalculateQuoteRequest" : {
        "type" : "object",
        "properties" : {
          "districtCode" : {
            "type" : "string"
          },
          "area" : {
            "type" : "number",
            "maximum" : 2000.0,
            "minimum" : 1.0
          },
          "areaBasis" : {
            "type" : "string",
            "enum" : [ "GROSS", "NET" ]
          },
          "layout" : {
            "type" : "string",
            "enum" : [ "STUDIO", "ONE_PLUS_ONE", "TWO_PLUS_ONE", "THREE_PLUS_ONE", "FOUR_PLUS_ONE", "FIVE_PLUS_ONE" ]
          },
          "scope" : {
            "type" : "string",
            "enum" : [ "WHOLE_HOME", "SELECTED_ROOMS" ]
          },
          "selectedRooms" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "LIVING_ROOM", "MASTER_BEDROOM", "BEDROOM", "STUDY", "KITCHEN", "BATHROOM", "HALLWAY", "BALCONY" ]
            },
            "uniqueItems" : true
          },
          "wallCondition" : {
            "type" : "string",
            "enum" : [ "GOOD", "MINOR", "MAJOR", "UNSURE" ]
          },
          "furnishing" : {
            "type" : "string",
            "enum" : [ "EMPTY", "PARTIAL", "FURNISHED" ]
          },
          "doorCount" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 60,
            "minimum" : 0
          },
          "doorColourChange" : {
            "type" : "boolean"
          },
          "doorCountEstimated" : {
            "type" : "boolean"
          },
          "hasElevator" : {
            "type" : "boolean"
          },
          "rush" : {
            "type" : "boolean"
          }
        },
        "required" : [ "area", "areaBasis", "districtCode", "furnishing", "layout", "scope", "wallCondition" ]
      },
      "QuoteCalculationResponse" : {
        "type" : "object",
        "properties" : {
          "priceBookVersion" : {
            "type" : "string"
          },
          "netArea" : {
            "type" : "number"
          },
          "areaWasGross" : {
            "type" : "boolean"
          },
          "rooms" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CalculatedRoomResponse"
            }
          },
          "photoCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "lines" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/QuoteLineResponse"
            }
          },
          "totalMinutes" : {
            "type" : "number"
          },
          "billableDays" : {
            "type" : "integer",
            "format" : "int32"
          },
          "minimumCost" : {
            "type" : "number"
          },
          "minimumBinding" : {
            "type" : "boolean"
          },
          "totalCost" : {
            "type" : "number"
          },
          "subtotalExVat" : {
            "type" : "number"
          },
          "vatAmount" : {
            "type" : "number"
          },
          "total" : {
            "type" : "number"
          },
          "labour" : {
            "$ref" : "#/components/schemas/QuotePortionResponse"
          },
          "material" : {
            "$ref" : "#/components/schemas/QuotePortionResponse"
          },
          "bandRatio" : {
            "type" : "number"
          },
          "bandLow" : {
            "type" : "number"
          },
          "bandHigh" : {
            "type" : "number"
          }
        },
        "required" : [ "areaWasGross", "bandHigh", "bandLow", "bandRatio", "billableDays", "labour", "lines", "material", "minimumBinding", "minimumCost", "netArea", "photoCount", "priceBookVersion", "rooms", "subtotalExVat", "total", "totalCost", "totalMinutes", "vatAmount" ]
      },
      "QuoteLineResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "WALL_PAINT", "CEILING_PAINT", "PATCH_FILLING", "SKIM_COAT", "PRIMER", "STAIN_BLOCK_PRIMER", "WALLPAPER_STRIPPING", "DOOR_PAINT", "TRIM_PAINT", "RADIATOR_PAINT", "DOWNLIGHT_CUTTING", "CORNICE_CUTTING", "MASKING", "MOBILIZATION" ]
          },
          "unit" : {
            "type" : "string",
            "enum" : [ "SQM", "UNIT", "ROOM", "LUMP_SUM" ]
          },
          "quantity" : {
            "type" : "number"
          },
          "labourCost" : {
            "type" : "number"
          },
          "materialCost" : {
            "type" : "number"
          },
          "lineTotal" : {
            "type" : "number"
          }
        },
        "required" : [ "code", "labourCost", "lineTotal", "materialCost", "quantity", "unit" ]
      },
      "QuotePortionResponse" : {
        "type" : "object",
        "properties" : {
          "totalCost" : {
            "type" : "number"
          },
          "subtotalExVat" : {
            "type" : "number"
          },
          "vatAmount" : {
            "type" : "number"
          },
          "total" : {
            "type" : "number"
          }
        },
        "required" : [ "subtotalExVat", "total", "totalCost", "vatAmount" ]
      },
      "CreatePriceBookVersionRequest" : {
        "type" : "object",
        "properties" : {
          "sourceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "versionCode" : {
            "type" : "string",
            "maxLength" : 32,
            "minLength" : 0,
            "pattern" : "[A-Z0-9-]+"
          }
        },
        "required" : [ "sourceId", "versionCode" ]
      },
      "PriceBookSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "versionCode" : {
            "type" : "string"
          },
          "active" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "active", "createdAt", "id", "versionCode" ]
      },
      "BulkIncreaseRequest" : {
        "type" : "object",
        "properties" : {
          "target" : {
            "type" : "string",
            "enum" : [ "LABOUR", "MATERIAL", "ALL" ]
          },
          "percent" : {
